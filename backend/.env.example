# --- Database ---
# Preferred: Neon PostgreSQL connection string (SSL required, enabled by default)
DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require&channel_binding=require

# Fallback: local Docker Postgres (used only if DATABASE_URL is unset).

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Auth ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
